            <article class="plan" data-custom-price="39" data-custom-bots="5"
              data-custom-storage="5000" data-no-terms>
              <h3 class="plan__name" data-i18n="plans.plan-name.1">Estándar</h3>
              <p class="plan__pitch" data-i18n="plans.plan-pitch.1">Para más consultas y
                solicitudes.</p>
              <!-- One block, three lines tall in either period: the line the
                   crossed-out price needs is reserved even in the monthly view,
                   so switching moves nothing below it. -->
              <p class="price">
                <span class="price__was" data-money data-usd="39">$39</span>
                <span class="price__amount price__amount--monthly" data-money
                  data-usd="39">$39</span>
                <span class="price__amount price__amount--yearly" data-money
                  data-usd="31.20">$31.20</span>
                <span class="price__unit price__unit--monthly"
                  data-i18n="plans.price-unit.2">al mes</span>
                <span class="price__unit price__unit--yearly"
                  data-i18n="plans.price-unit.3">al mes</span>
              </p>
              <!-- Buy button: uncomment when checkout exists and point
                   it at the plan. Until then the header carries the
                   waitlist, and that is enough to say what to do. -->
              <!-- <a class="btn btn--primary plan__cta" href="mailto:info@pautia.app?subject=Waitlist%20for%20Pautia">
                Join the waitlist</a> -->
              <dl class="plan__rows">
                <div class="row">
                  <dt class="row__key">
                    <span data-i18n="plans.row-key.5">Agentes</span>
                  </dt>
                  <dd class="row__value"><span data-i18n="plans.row-value.5">5</span>
                    <button class="row__help" type="button"
                      aria-label="Cantidad máxima de agentes activos al mismo tiempo."
                      data-i18n-attrs="aria-label:plans.row-tip.0">?<span
                        class="row__tip" aria-hidden="true"
                        data-i18n="plans.row-tip.0">Cantidad máxima de agentes activos al mismo
                        tiempo.</span></button></dd>
                </div>
                <div class="row">
                  <dt class="row__key">
                    <span data-i18n="plans.row-key.9">Almacenamiento</span>
                  </dt>
                  <dd class="row__value"><span data-i18n="plans.row-value.9">5 GB</span>
                    <button class="row__help" type="button"
                      aria-label="Historial y datos de gestión interna, si la usas."
                      data-i18n-attrs="aria-label:plans.row-tip.4">?<span
                        class="row__tip" aria-hidden="true"
                        data-i18n="plans.row-tip.4">Historial y datos de gestión interna,
                        si la usas.</span></button></dd>
                </div>
                <div class="row">
                  <dt class="row__key">
                    <span data-i18n="plans.ai-label">Créditos de IA</span>
                  </dt>
                  <dd class="row__value"><span data-i18n="plans.ai-standard">5.000</span>
                    <button class="row__help" type="button"
                      aria-label="Saldo mensual para Smart Imports, Smart Routing y multimedia."
                      data-i18n-attrs="aria-label:plans.ai-tip">?<span class="row__tip"
                        aria-hidden="true" data-i18n="plans.ai-tip">Saldo mensual para
                        Smart Imports, Smart Routing y multimedia.</span></button></dd>
                </div>
                <div class="row">
                  <dt class="row__key">
                    <span data-i18n="plans.media-label">Entiende mensajes</span>
                  </dt>
                  <dd class="row__value row__value--text"><span
                    data-i18n="plans.media-standard">Texto + audio</span>
                    <button class="row__help" type="button"
                      aria-label="Tipos de entrada que interpreta; no formatos de respuesta."
                      data-i18n-attrs="aria-label:plans.media-tip">?<span class="row__tip"
                        aria-hidden="true" data-i18n="plans.media-tip">Tipos de entrada que
                        interpreta; no formatos de respuesta.</span></button></dd>
                </div>
                <div class="row">
                  <dt class="row__key">
                    <span data-i18n="plans.users-label">Usuarios del panel</span>
                  </dt>
                  <dd class="row__value"><span data-i18n="plans.users-standard">3</span>
                    <button class="row__help" type="button"
                      aria-label="Personas del equipo con acceso al panel;
                        no clientes de mensajería."
                      data-i18n-attrs="aria-label:plans.users-tip">?<span class="row__tip"
                        aria-hidden="true" data-i18n="plans.users-tip">Personas del equipo con
                        acceso al panel; no clientes de mensajería.</span></button></dd>
                </div>
              </dl>
            </article>
