          <section class="custom-plan" aria-labelledby="custom-plan-title">
            <div class="custom-plan__head">
              <h3 id="custom-plan-title" data-i18n="custom-plan.title">Personaliza tu plan</h3>
              <p data-i18n="custom-plan.intro">Elige un plan base y ajusta los recursos
                a tu medida.</p>
            </div>
            <div class="custom-plan__layout" data-custom-plan>
              <div class="custom-plan__builder">
                <fieldset class="custom-plan__tiers">
                  <legend data-i18n="custom-plan.base-label">Plan base</legend>
                  <label class="custom-plan__tier">
                    <input type="radio" name="custom-plan-base" value="basic"
                      data-plan-index="0">
                    <span class="custom-plan__tier-copy">
                      <strong data-custom-name data-i18n="custom-plan.plan-basic">Básico</strong>
                      <span data-i18n="custom-plan.feature-basic">Solo texto</span>
                    </span>
                  </label>
                  <label class="custom-plan__tier custom-plan__tier--featured">
                    <input type="radio" name="custom-plan-base" value="standard"
                      data-plan-index="1" checked>
                    <span class="custom-plan__tier-copy">
                      <strong data-custom-name
                        data-i18n="custom-plan.plan-standard">Estándar</strong>
                      <span data-i18n="custom-plan.feature-standard">Texto y audio</span>
                    </span>
                  </label>
                  <label class="custom-plan__tier">
                    <input type="radio" name="custom-plan-base" value="professional"
                      data-plan-index="2">
                    <span class="custom-plan__tier-copy">
                      <strong data-custom-name
                        data-i18n="custom-plan.plan-professional">Profesional</strong>
                      <span data-i18n="custom-plan.feature-professional">Texto, audio, imágenes
                        y documentos</span>
                    </span>
                  </label>
                </fieldset>

                <div class="custom-plan__controls">
                  <div class="custom-plan__control">
                    <div class="custom-plan__control-head">
                      <label for="custom-bots" data-i18n="custom-plan.bots-label">Bots</label>
                      <output id="custom-bots-output" for="custom-bots">5</output>
                    </div>
                    <p id="custom-bots-help" data-i18n="custom-plan.bots-help">Agentes activos
                      al mismo tiempo.</p>
                    <input id="custom-bots" type="range" min="5" max="100" step="1" value="5"
                      aria-describedby="custom-bots-help">
                    <div class="custom-plan__bounds" aria-hidden="true">
                      <span data-custom-min="bots">5</span>
                      <span data-custom-max="bots">100</span>
                    </div>
                  </div>
                  <div class="custom-plan__control">
                    <div class="custom-plan__control-head">
                      <label for="custom-storage" data-i18n="custom-plan.storage-label">
                        Almacenamiento</label>
                      <output id="custom-storage-output" for="custom-storage">5 GB</output>
                    </div>
                    <p id="custom-storage-help" data-i18n="custom-plan.storage-help">
                      Historial y datos de gestión interna, si la usas.</p>
                    <input id="custom-storage" type="range" min="5000" max="1000000" step="50"
                      value="5000" aria-describedby="custom-storage-help">
                    <div class="custom-plan__bounds" aria-hidden="true">
                      <span data-custom-min="storage">5 GB</span>
                      <span data-custom-max="storage">1 TB</span>
                    </div>
                  </div>
                </div>
              </div>

              <aside class="custom-plan__summary" aria-labelledby="custom-summary-title">
                <h4 id="custom-summary-title" data-i18n="custom-plan.summary-title">
                  Tu configuración</h4>
                <p class="custom-plan__selected" data-custom-selected>Estándar</p>
                <dl class="custom-plan__breakdown">
                  <div>
                    <dt data-i18n="custom-plan.summary-base">Plan base</dt>
                    <dd><span data-money data-custom-price="base" data-usd="39">$39</span></dd>
                  </div>
                  <div>
                    <dt data-i18n="custom-plan.summary-bots">Bots adicionales</dt>
                    <dd><span data-money data-custom-price="bots" data-usd="0">$0</span></dd>
                  </div>
                  <div>
                    <dt data-i18n="custom-plan.summary-storage">
                      Almacenamiento adicional</dt>
                    <dd><span data-money data-custom-price="storage" data-usd="0">$0</span></dd>
                  </div>
                </dl>
                <div class="custom-plan__total">
                  <span data-i18n="custom-plan.total">Precio estimado</span>
                  <strong><span data-money data-custom-price="total" data-usd="39">$39</span>
                    <span data-i18n="custom-plan.per-month">al mes</span></strong>
                </div>
                <p class="custom-plan__annual" hidden>
                  <span data-i18n="custom-plan.annual-lead">Total anual:</span>
                  <span data-money data-custom-price="annual" data-usd="374.40">$374.40</span>
                  <span data-i18n="custom-plan.annual-tail">al año</span>
                </p>
                <p class="custom-plan__note">
                  <span data-i18n="custom-plan.rates-lead">Extras por uso:</span>
                  <span data-money data-usd="5">$5</span>
                  <span data-i18n="custom-plan.rates-bot">por cada bot,</span>
                  <span data-money data-usd="1">$1</span>
                  <span data-i18n="custom-plan.rates-storage">por GB adicional; descuentos por
                    volumen.</span></p>
              </aside>
            </div>
          </section>
