<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title data-i18n="page.title.0">Pautia · Gestiona tu negocio con agentes predecibles</title>
  <meta name="description" data-i18n-attrs="content:meta.description"
    content="Atiende por mensajería y gestiona solicitudes en Pautia. Tus reglas, tu agente,
      tu panel.">
  <link rel="canonical" href="https://pautia.app/">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Pautia">
  <meta property="og:locale" content="es_ES" data-i18n-attrs="content:meta.og-locale">
  <meta property="og:title" data-i18n-attrs="content:meta.og-title"
    content="Pautia · Gestiona tu negocio con agentes predecibles">
  <meta property="og:description" data-i18n-attrs="content:meta.og-description"
    content="Atiende por mensajería y gestiona solicitudes en Pautia. Tus reglas, tu agente,
      tu panel.">
  <meta property="og:url" content="https://pautia.app/">
  <meta property="og:image" content="https://pautia.app/assets/og.png">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/assets/favicon-horizontal.svg" type="image/svg+xml">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0e7c6b" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="/assets/styles.css">

  <script type="application/json" id="languages">
    [
      {"code": "es", "name": "Español", "file": "es.json"},
      {"code": "en", "name": "English", "file": "en.json"},
      {"code": "pt", "name": "Português", "file": "pt.json"},
      {"code": "fr", "name": "Français", "file": "fr.json"},
      {"code": "de", "name": "Deutsch", "file": "de.json"},
      {"code": "it", "name": "Italiano", "file": "it.json"}
    ]
  </script>

  <script>
    // Only a language different from the served page needs a dictionary fetch.
    (() => {
      try {
        const found = document.cookie.match(/(?:^|;\s*)pautia:lang=([\w-]+)/);
        if (!found) return;
        const list = JSON.parse(document.getElementById("languages").textContent);
        const lang = list.find((l) => l.code === found[1]);
        if (!lang || lang.code === document.documentElement.lang) return;
        document.documentElement.dataset.lang = lang.code;
        const link = document.createElement("link");
        link.rel = "preload";
        link.as = "fetch";
        link.crossOrigin = "anonymous";
        link.href = "/assets/i18n/" + lang.file;
        document.head.append(link);
      } catch {}
    })();
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Pautia",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "url": "https://pautia.app/",
    "inLanguage": "es",
    "description":
      "Atiende por mensajería y gestiona solicitudes en Pautia. Tus reglas, tu agente, tu panel.",
    "offers": [
      {"@type": "Offer", "name": "Básico", "priceCurrency": "USD", "price": "9"},
      {"@type": "Offer", "name": "Estándar", "priceCurrency": "USD", "price": "39"},
      {"@type": "Offer", "name": "Profesional", "priceCurrency": "USD", "price": "69"}
    ]
  }
  </script>
</head>

