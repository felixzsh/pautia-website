    <!-- The full plan table: the three priced plans, the Enterprise card and the
         builder, all in one route so the landing page can stay short. -->
    <section class="section" id="plans">
      <div class="wrap">
        <div class="section__head">
          <h1 id="plans-t" data-i18n="pricing.h1.0">Planes y precios</h1>
          <p data-i18n="plans.p.0">Precios propuestos en USD. Elige el tamaño que necesita tu
            negocio.</p>
        </div>

        <div class="plans">
{% include "plans-bar.njk" %}

          <div class="plans__grid">
{% include "plan-basic.njk" %}

{% include "plan-standard.njk" %}

{% include "plan-professional.njk" %}

{% include "plan-enterprise.njk" %}
          </div>
{% include "custom-plan.njk" %}
        </div>

{% include "plans-included.njk" %}
{% include "plans-facts.njk" %}
      </div>
    </section>
  </main>

{% include "footer.njk" %}

  <script src="/assets/main.js"></script>
</body>

</html>
